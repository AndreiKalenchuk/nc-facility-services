# Resend API key — create one at https://resend.com/api-keys
# Used by the Netlify Function at netlify/functions/send-quote.js
RESEND_API_KEY=your_resend_api_key_here

# Address that receives contact/quote form submissions
QUOTE_TO_EMAIL=ncfacilityserv@gmail.com

# Sender address. Use Resend's test sender until you verify a custom domain.
QUOTE_FROM_EMAIL=NC Facility Services <onboarding@resend.dev>
