# Resend API key — create one at https://resend.com/api-keys
# Used by the Netlify Function at netlify/functions/send-quote.js
RESEND_API_KEY=your_resend_api_key_here

# Address that receives contact/quote form submissions
QUOTE_TO_EMAIL=ncfacilityserv@gmail.com

# Sender address. MUST be an address on a domain you have verified in Resend
# (https://resend.com/domains) — and verified in the SAME Resend team that
# issued RESEND_API_KEY. Domains and API keys are scoped per team, so a domain
# verified in another team will not work here.
QUOTE_FROM_EMAIL=NC Facility Services <quotes@ncfacilityserveces.com>

# The fallback below is Resend's shared test sender. It ONLY delivers to the
# email address that owns the Resend account, so QUOTE_TO_EMAIL above will be
# rejected. Use it for local smoke tests only.
# QUOTE_FROM_EMAIL=NC Facility Services <onboarding@resend.dev>
